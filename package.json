{
  "name": "beehiiv-react",
  "version": "0.7.0",
  "description": "Connect a beehiiv account to your React/Next.js project — typed API client, React hooks, subscription form component, and CLI scaffolding tool.",
  "keywords": [
    "beehiiv",
    "react",
    "nextjs",
    "newsletter",
    "typescript"
  ],
  "license": "MIT",
  "author": "EJ White",
  "homepage": "https://github.com/ejwhite7/beehiiv-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejwhite7/beehiiv-react.git"
  },
  "bugs": {
    "url": "https://github.com/ejwhite7/beehiiv-react/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query/index.d.mts",
        "default": "./dist/query/index.mjs"
      },
      "require": {
        "types": "./dist/query/index.d.ts",
        "default": "./dist/query/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.mts",
        "default": "./dist/server/index.mjs"
      },
      "require": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      }
    }
  },
  "bin": {
    "beehiiv-react": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test && npm run test:pack",
    "generate:types": "openapi-typescript src/types/beehiiv-api-spec.yaml -o src/types/beehiiv-api.generated.ts",
    "check:spec": "curl -sf https://files.buildwithfern.com/https://beehiiv.docs.buildwithfern.com/ce117ceb8170960e1daef3750597e88705645d547d7ee2fee49c5bebfd5c6b6d/assets/beehiiv-API-Specification.yaml -o /dev/null && echo \"beehiiv OpenAPI spec is available\" || (echo \"No beehiiv OpenAPI spec found\" && exit 1)"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "handlebars": "^4.7.8",
    "inquirer": "^9.0.0",
    "open": "^10.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.100.6",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^7.13.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
