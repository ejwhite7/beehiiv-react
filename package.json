{
  "name": "beehiiv-react",
  "version": "0.3.3",
  "description": "Connect a beehiiv account to your React/Next.js project \u2014 typed API client, React hooks, subscription form component, and CLI scaffolding tool.",
  "keywords": [
    "beehiiv",
    "react",
    "nextjs",
    "newsletter",
    "typescript"
  ],
  "license": "MIT",
  "author": "EJ White",
  "homepage": "https://github.com/ejwhite7/beehiiv-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejwhite7/beehiiv-react.git"
  },
  "bugs": {
    "url": "https://github.com/ejwhite7/beehiiv-react/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js",
      "require": "./dist/query/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    }
  },
  "bin": {
    "beehiiv-react": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@tanstack/react-query": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "handlebars": "^4.7.8",
    "inquirer": "^9.0.0",
    "open": "^10.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.100.6",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "jsdom": "^24.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
