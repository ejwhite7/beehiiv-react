exports[`analytics.ts.hbs > generates the analytics utility 1`] = `
"/**
 * Client-side analytics utility for dataLayer (GTM) event tracking.
 * Generated by beehiiv-react — do not edit directly.
 */

declare global {
  interface Window {
    dataLayer: Record<string, unknown>[];
  }
}

/**
 * Push an event to the GTM dataLayer.
 *
 * Safe to call server-side (no-ops when \`window\` is undefined).
 *
 * @param event - The event name (e.g. "beehiiv_subscribe_success")
 * @param data - Optional key-value payload merged into the dataLayer entry
 */
export function pushEvent(event: string, data?: Record<string, unknown>): void {
  if (typeof window === 'undefined') return;
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event, ...data });
}
"
`;

exports[`blog-post-page.tsx.hbs > generates the blog post detail page 1`] = `
"/**
 * Blog post detail page.
 * Generated by \`beehiiv-react init\` (blog feature).
 * Located at: app/blog/[slug]/page.tsx
 *
 * Renders a single beehiiv post resolved by slug. Access is enforced
 * server-side from the post audience and \`enforce_gated_content\` flag.
 * Wire up your own auth/session logic in \`getViewerSubscription()\`.
 */
import { cache } from 'react';
import { notFound } from 'next/navigation';
import {
  BeehiivClient,
  fetchPostBySlug,
  fetchAllPostSlugs,
  generatePostMetadata,
  sanitizeBeehiivPostContent,
  canViewContent,
} from 'beehiiv-react/server';
import { PostContentRenderer } from 'beehiiv-react';

export const revalidate = 300;

const PUBLICATION_ID =
  process.env.BEEHIIV_PUBLICATION_ID ?? 'pub_blog';
const SITE_URL = process.env.NEXT_PUBLIC_SITE_URL ?? '';

function getClient() {
  return new BeehiivClient({
    apiKey: process.env.BEEHIIV_API_KEY!,
    publicationId: PUBLICATION_ID,
  });
}

/**
 * Resolve a post by slug, memoised per-request with React \`cache()\`.
 *
 * \`generateMetadata\` and the page component both need the post; wrapping the
 * fetch in \`cache()\` means the underlying posts-list scan + content fetch run
 * once per render instead of twice.
 */
const getPost = cache((slug: string) =>
  fetchPostBySlug(getClient(), PUBLICATION_ID, slug),
);

export async function generateStaticParams() {
  return fetchAllPostSlugs(getClient(), PUBLICATION_ID);
}

export async function generateMetadata({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;
  const post = await getPost(slug);
  if (!post) return {};
  return generatePostMetadata(post, {
    canonicalUrl: SITE_URL ? \`\${SITE_URL}/blog/\${slug}\` : undefined,
  });
}

/**
 * Stub for resolving the current viewer's subscription tier.
 * Replace with your own auth integration (NextAuth, Clerk, custom JWT, etc.).
 */
async function getViewerSubscription(): Promise<{
  status?: 'active' | 'inactive';
  tier?: 'free' | 'premium';
} | null> {
  return null;
}

export default async function BlogPostPage({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;
  const post = await getPost(slug);
  if (!post) notFound();

  // Use the same policy as the package hooks/components and public posts API.
  // Missing gate metadata fails closed. Replace getViewerSubscription() with
  // your own server-side auth/session lookup.
  const subscription = await getViewerSubscription();
  const canView = canViewContent(
    subscription?.tier ?? null,
    subscription?.status ?? null,
    post.audience,
    post.enforce_gated_content ?? true,
  );
  const sanitizedContent = sanitizeBeehiivPostContent(post.content ?? null);

  return (
    <article className="beehiiv-blog-post">
      <header>
        <h1>{post.title}</h1>
        {post.subtitle && <p className="subtitle">{post.subtitle}</p>}
        {post.publish_date != null && (
          <time dateTime={new Date(post.publish_date * 1000).toISOString()}>
            {new Date(post.publish_date * 1000).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        )}
      </header>

      {canView ? (
        <PostContentRenderer
          content={sanitizedContent}
          htmlIsSanitized
        />
      ) : (
        <div className="beehiiv-paywall">
          <h2>This post is for paid subscribers</h2>
          <p>Subscribe to unlock full access.</p>
        </div>
      )}
    </article>
  );
}
"
`;

exports[`blog-sitemap.ts.hbs > generates the sitemap route 1`] = `
"/**
 * Next.js sitemap entry for the blog route.
 * Generated by \`beehiiv-react init\` (blog feature).
 * Located at: app/blog/sitemap.ts
 *
 * Next.js will pick this up automatically and serve it at
 * \`/blog/sitemap.xml\`. Reference it from your top-level
 * \`robots.txt\` or root sitemap index.
 */
import type { MetadataRoute } from 'next';
import { BeehiivClient, fetchAllPosts } from 'beehiiv-react/server';

export const revalidate = 3600;

const PUBLICATION_ID =
  process.env.BEEHIIV_PUBLICATION_ID ?? 'pub_blog';
const SITE_URL = process.env.NEXT_PUBLIC_SITE_URL ?? '';

export default async function sitemap(): Promise<MetadataRoute.Sitemap> {
  const client = new BeehiivClient({
    apiKey: process.env.BEEHIIV_API_KEY!,
    publicationId: PUBLICATION_ID,
  });

  // Paginates through every confirmed post — the beehiiv list endpoint caps
  // \`limit\` at 100 per request, so a single large \`limit\` would silently
  // truncate the sitemap for publications with more than 100 posts.
  const posts = await fetchAllPosts(client, PUBLICATION_ID, {
    status: 'confirmed',
  });

  const indexEntry: MetadataRoute.Sitemap[number] = {
    url: \`\${SITE_URL}/blog\`,
    changeFrequency: 'daily',
    priority: 0.9,
  };

  const postEntries: MetadataRoute.Sitemap = posts
    .filter((p) => p.slug)
    .map((p) => ({
      url: \`\${SITE_URL}/blog/\${p.slug}\`,
      lastModified:
        p.publish_date != null ? new Date(p.publish_date * 1000) : undefined,
      changeFrequency: 'weekly',
      priority: 0.7,
    }));

  return [indexEntry, ...postEntries];
}
"
`;

exports[`posts-route.ts.hbs > generates a valid Next.js posts API route 1`] = `
"/**
 * Next.js App Router API route for beehiiv posts (list + detail)
 * Generated by beehiiv-react — do not edit directly.
 * Located at: app/api/beehiiv/posts/route.ts
 */
import { NextRequest, NextResponse } from 'next/server';
import {
  BeehiivClient,
  canViewContent,
  fetchPostBySlug,
} from 'beehiiv-react/server';

const DEFAULT_PUBLICATION_ID =
  process.env.BEEHIIV_PUBLICATION_ID ?? 'pub_posts123';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: DEFAULT_PUBLICATION_ID,
});

/**
 * GET /api/beehiiv/posts
 *
 *  - Without \`slug\`: list posts with page-based pagination.
 *  - With \`?slug=my-post\`: resolve a single post by slug. Returns
 *    \`{ data: PostInfo | null }\` so the client can distinguish 200-with-null
 *    from a server error.
 */
export async function GET(req: NextRequest) {
  try {
    const searchParams = req.nextUrl.searchParams;

    // This route is a public, read-only projection. Never forward caller-
    // controlled publication, visibility, or expansion parameters to beehiiv.
    // Add a separately authenticated route if your application needs drafts,
    // premium posts, or expanded content.
    const restrictedParameters = [
      'publicationId',
      'publication_id',
      'status',
      'audience',
      'expand',
      'expand[]',
    ];
    if (restrictedParameters.some((parameter) => searchParams.has(parameter))) {
      return NextResponse.json(
        { error: 'Unsupported public posts query' },
        { status: 400 },
      );
    }

    // --- Slug lookup branch ---
    const slug = searchParams.get('slug');
    if (slug) {
      const post = await fetchPostBySlug(client, DEFAULT_PUBLICATION_ID, slug, {
        status: 'confirmed',
      });
      const publicPost =
        post?.status === 'confirmed' &&
        canViewContent(
          null,
          null,
          post.audience,
          post.enforce_gated_content ?? true,
        )
          ? post
          : null;
      return NextResponse.json({ data: publicPost }, { status: 200 });
    }

    const page = searchParams.get('page');
    const limit = searchParams.get('limit');
    const orderBy = searchParams.get('order_by') ?? 'publish_date';
    const direction = searchParams.get('direction') ?? 'desc';

    const response = await client.posts.list({
      page: page ? Number(page) : undefined,
      limit: limit ? Number(limit) : undefined,
      status: 'confirmed',
      orderBy: orderBy === 'created_at' ? 'created_at' : 'publish_date',
      direction: direction === 'asc' ? 'asc' : 'desc',
    });

    return NextResponse.json(
      {
        data: response.data.filter(
          (post) =>
            post.status === 'confirmed' &&
            canViewContent(
              null,
              null,
              post.audience,
              post.enforce_gated_content ?? true,
            ),
        ),
        pagination: {
          page: response.page,
          limit: response.limit,
          total_results: response.total_results,
          total_pages: response.total_pages,
        },
      },
      { status: 200 },
    );
  } catch (error: unknown) {
    const message =
      error instanceof Error ? error.message : 'Failed to fetch posts';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
"
`;

exports[`subscribe-cta.tsx.hbs > generates the SubscribeCTA component 1`] = `
"/**
 * Subscribe CTA component with subscriber persistence and analytics.
 * Hides automatically when the user has already subscribed.
 * Generated by beehiiv-react — do not edit directly.
 */
'use client';

import { useEffect, useTransition } from 'react';
import { subscribeAction } from '@/lib/beehiiv/actions';
import { useSubscriberStatus } from '@/hooks/use-subscriber-status';
import { pushEvent } from '@/lib/beehiiv/analytics';

export interface SubscribeCTAProps {
  /** Where this CTA is rendered (e.g. "header", "footer", "sidebar") */
  location?: string;
  /** CSS class for the form wrapper */
  className?: string;
  /** Label for the submit button */
  submitLabel?: string;
  /** Placeholder for the email input */
  placeholder?: string;
  /** Whether the user is already subscribed (from server-side cookie check) */
  serverIsSubscribed?: boolean;
}

export function SubscribeCTA({
  location = 'inline',
  className,
  submitLabel = 'Subscribe',
  placeholder = 'Enter your email',
  serverIsSubscribed,
}: SubscribeCTAProps) {
  const { isSubscribed, markSubscribed } = useSubscriberStatus(serverIsSubscribed);
  const [isPending, startTransition] = useTransition();

  useEffect(() => {
    if (!isSubscribed) {
      pushEvent('beehiiv_subscribe_cta_viewed', { location });
    }
  }, [isSubscribed, location]);

  if (isSubscribed) {
    return null;
  }

  function handleSubmit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    const formData = new FormData(e.currentTarget);
    const email = formData.get('email') as string;
    if (!email) return;

    const emailDomain = email.split('@')[1] ?? 'unknown';
    pushEvent('beehiiv_subscribe_form_submitted', { email_domain: emailDomain });

    startTransition(async () => {
      try {
        const result = await subscribeAction({ email });
        pushEvent('beehiiv_subscribe_success', {
          publication_id: result?.publication_id ?? '',
        });
        markSubscribed();
      } catch (err: unknown) {
        const errorCode = err instanceof Error ? err.message : 'unknown_error';
        pushEvent('beehiiv_subscribe_error', { error_code: errorCode });
      }
    });
  }

  return (
    <form onSubmit={handleSubmit} className={className}>
      <input
        name="email"
        type="email"
        placeholder={placeholder}
        required
        disabled={isPending}
        aria-label="Email address"
        aria-required="true"
        autoComplete="email"
      />
      <button type="submit" disabled={isPending}>
        {isPending ? 'Subscribing...' : submitLabel}
      </button>
    </form>
  );
}
"
`;

exports[`subscribe-step-two.tsx.hbs > generates the SubscribeStepTwo component 1`] = `
"/**
 * SubscribeStepTwo — multi-step subscribe form (step 2: enrich subscription).
 * Collects additional data after initial subscribe and hides if already subscribed.
 * Generated by beehiiv-react — do not edit directly.
 */
'use client';

import { useEffect, useTransition, useState } from 'react';
import { enrichSubscriptionAction } from '@/lib/beehiiv/actions';
import { useSubscriberStatus } from '@/hooks/use-subscriber-status';
import { pushEvent } from '@/lib/beehiiv/analytics';
import type { BeehiivCustomFields } from '@/lib/beehiiv/beehiiv-custom-fields';

export interface SubscribeStepTwoProps {
  /** The subscription ID returned from step 1 */
  subscriptionId: string;
  /** Custom field configurations to collect */
  fields?: Array<{
    key: string;
    label: string;
    type?: 'text' | 'number' | 'select';
    options?: string[];
    required?: boolean;
  }>;
  /** CSS class for the form wrapper */
  className?: string;
  /** Whether the user is already subscribed (from server-side cookie check) */
  serverIsSubscribed?: boolean;
  /** Called on successful enrichment */
  onSuccess?: () => void;
}

export function SubscribeStepTwo({
  subscriptionId,
  fields = [],
  className,
  serverIsSubscribed,
  onSuccess,
}: SubscribeStepTwoProps) {
  const { isSubscribed, markSubscribed } = useSubscriberStatus(serverIsSubscribed);
  const [isPending, startTransition] = useTransition();
  const [fieldValues, setFieldValues] = useState<Record<string, string>>({});

  useEffect(() => {
    pushEvent('beehiiv_step_two_viewed', {});
  }, []);

  if (isSubscribed) {
    return null;
  }

  function handleSubmit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    pushEvent('beehiiv_step_two_submitted', {});

    startTransition(async () => {
      try {
        await enrichSubscriptionAction(
          subscriptionId,
          fieldValues as unknown as Partial<BeehiivCustomFields>,
        );
        pushEvent('beehiiv_step_two_success', {});
        markSubscribed();
        onSuccess?.();
      } catch {
        // Step two errors are non-critical
      }
    });
  }

  return (
    <form onSubmit={handleSubmit} className={className}>
      {fields.map((field) => (
        <div key={field.key}>
          <label htmlFor={\`step2-\${field.key}\`}>{field.label}</label>
          {field.type === 'select' && field.options ? (
            <select
              id={\`step2-\${field.key}\`}
              value={fieldValues[field.key] ?? ''}
              onChange={(e) =>
                setFieldValues((prev) => ({ ...prev, [field.key]: e.target.value }))
              }
              required={field.required}
              disabled={isPending}
              aria-required={field.required ? 'true' : undefined}
              autoComplete="off"
            >
              <option value="">Select...</option>
              {field.options.map((opt) => (
                <option key={opt} value={opt}>
                  {opt}
                </option>
              ))}
            </select>
          ) : (
            <input
              id={\`step2-\${field.key}\`}
              type={field.type === 'number' ? 'number' : 'text'}
              value={fieldValues[field.key] ?? ''}
              onChange={(e) =>
                setFieldValues((prev) => ({ ...prev, [field.key]: e.target.value }))
              }
              required={field.required}
              disabled={isPending}
              aria-required={field.required ? 'true' : undefined}
              autoComplete="off"
            />
          )}
        </div>
      ))}
      <button type="submit" disabled={isPending}>
        {isPending ? 'Submitting...' : 'Complete'}
      </button>
    </form>
  );
}
"
`;

exports[`subscribe-wrapper.tsx.hbs > generates the server-side wrapper 1`] = `
"/**
 * Server-side wrapper for the SubscribeCTA component.
 * Reads the beehiiv_subscribed cookie on the server for flicker-free rendering.
 * Generated by beehiiv-react — do not edit directly.
 */
import { cookies } from 'next/headers';
import { SubscribeCTA } from './SubscribeCTA';
import type { SubscribeCTAProps } from './SubscribeCTA';

export type SubscribeWrapperProps = Omit<SubscribeCTAProps, 'serverIsSubscribed'>;

/**
 * Server Component wrapper that reads the subscription cookie
 * and passes it to the client SubscribeCTA component.
 * This prevents a flash of the subscribe form for returning subscribers.
 */
export async function SubscribeWrapper(props: SubscribeWrapperProps) {
  const cookieStore = await cookies();
  const isSubscribed = cookieStore.get('beehiiv_subscribed')?.value === 'true';

  return <SubscribeCTA {...props} serverIsSubscribed={isSubscribed} />;
}
"
`;

exports[`use-subscriber-status.ts.hbs > generates the hook with cookie and localStorage support 1`] = `
"/**
 * Hook for tracking whether the current user has subscribed.
 * Uses dual-layer persistence: cookie (SSR-safe) + localStorage (client fallback).
 * Generated by beehiiv-react — do not edit directly.
 */
'use client';

import { useState, useCallback, useEffect } from 'react';

const COOKIE_NAME = 'beehiiv_subscribed';
const LS_KEY = 'beehiiv_subscribed';
const COOKIE_MAX_AGE = 31536000; // 1 year in seconds

/**
 * Parse a cookie value by name from a cookie string.
 *
 * @param name - The cookie name to look up
 * @param cookieStr - The raw cookie string (document.cookie or header value)
 * @returns The cookie value, or null if not found
 */
function getCookie(name: string, cookieStr: string): string | null {
  const match = cookieStr.match(new RegExp(\`(?:^|;\\\\s*)\${name}=([^;]*)\`));
  return match ? decodeURIComponent(match[1]) : null;
}

/**
 * Set a cookie with the given name, value, and max-age.
 *
 * @param name - The cookie name
 * @param value - The cookie value
 * @param maxAge - Max-age in seconds
 */
function setCookie(name: string, value: string, maxAge: number): void {
  document.cookie = \`\${name}=\${encodeURIComponent(value)}; path=/; max-age=\${maxAge}; SameSite=Lax\`;
}

/** Return type for the useSubscriberStatus hook */
export interface UseSubscriberStatusReturn {
  /** Whether the current user has subscribed */
  isSubscribed: boolean;
  /** Mark the user as subscribed, persisting to both cookie and localStorage */
  markSubscribed: () => void;
}

/**
 * Hook that tracks whether the visitor has already subscribed.
 *
 * Reads from cookie first (works on SSR and client), falls back to
 * localStorage after hydration. \`markSubscribed()\` writes to both
 * cookie and localStorage and triggers a re-render.
 *
 * @param serverIsSubscribed - Optional server-side override (read from cookies() in RSC)
 * @returns The subscriber status and a function to mark as subscribed
 */
export function useSubscriberStatus(
  serverIsSubscribed?: boolean,
): UseSubscriberStatusReturn {
  const [isSubscribed, setIsSubscribed] = useState<boolean>(() => {
    if (serverIsSubscribed) return true;
    if (typeof document !== 'undefined') {
      const cookieVal = getCookie(COOKIE_NAME, document.cookie);
      if (cookieVal === 'true') return true;
    }
    return false;
  });

  // After hydration, also check localStorage as a fallback
  useEffect(() => {
    if (!isSubscribed && typeof window !== 'undefined') {
      try {
        const lsVal = localStorage.getItem(LS_KEY);
        if (lsVal === 'true') {
          setIsSubscribed(true);
          // Restore the cookie if it was lost
          setCookie(COOKIE_NAME, 'true', COOKIE_MAX_AGE);
        }
      } catch {
        // localStorage may be unavailable (private browsing, etc.)
      }
    }
  }, [isSubscribed]);

  const markSubscribed = useCallback(() => {
    setIsSubscribed(true);
    if (typeof document !== 'undefined') {
      setCookie(COOKIE_NAME, 'true', COOKIE_MAX_AGE);
    }
    if (typeof window !== 'undefined') {
      try {
        localStorage.setItem(LS_KEY, 'true');
      } catch {
        // localStorage may be unavailable
      }
    }
  }, []);

  return { isSubscribed, markSubscribed };
}
"
`;
