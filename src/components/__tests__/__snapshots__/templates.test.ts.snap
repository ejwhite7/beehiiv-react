exports[`api-route.ts.hbs > generates a valid Next.js API route 1`] = `
"/**
 * Next.js App Router API route for beehiiv subscription management
 * Generated by beehiiv-react — do not edit directly.
 * Located at: app/api/beehiiv/subscribe/route.ts
 */
import { NextRequest, NextResponse } from 'next/server';
import { BeehiivClient } from 'beehiiv-react/server';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: process.env.BEEHIIV_PUBLICATION_ID ?? 'pub_route456',
});

/**
 * Authorize access to subscriber data.
 *
 * This deliberately denies every request. Replace the body with a server-side
 * session and ownership check before enabling subscriber lookup. Never trust
 * the requested email address as proof of identity.
 */
async function isSubscriberLookupAuthorized(
  _req: NextRequest,
  _email: string | null,
): Promise<boolean> {
  return false;
}

/** POST /api/beehiiv/subscribe — Create a new subscription */
export async function POST(req: NextRequest) {
  try {
    const body = await req.json();

    if (!body.email || typeof body.email !== 'string') {
      return NextResponse.json(
        { error: 'A valid email address is required.' },
        { status: 400 },
      );
    }

    const subscription = await client.subscriptions.create({
      email: body.email,
      custom_fields: body.customFields,
      utm_source: body.utmSource,
      utm_medium: body.utmMedium,
      utm_campaign: body.utmCampaign,
      send_welcome_email: body.sendWelcomeEmail ?? true,
      reactivate_existing: body.reactivateExisting ?? false,
    });

    return NextResponse.json(subscription, { status: 200 });
  } catch (error: unknown) {
    const message =
      error instanceof Error ? error.message : 'Subscription failed';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}

/**
 * GET /api/beehiiv/subscribe?email=... — Look up a subscription by email.
 * Fails closed until isSubscriberLookupAuthorized is implemented above.
 */
export async function GET(req: NextRequest) {
  try {
    const email = req.nextUrl.searchParams.get('email');

    if (!(await isSubscriberLookupAuthorized(req, email))) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    if (!email) {
      return NextResponse.json(
        { error: 'The "email" query parameter is required.' },
        { status: 400 },
      );
    }

    const subscription = await client.subscriptions.list({ email });

    return NextResponse.json(subscription, { status: 200 });
  } catch (error: unknown) {
    const message =
      error instanceof Error ? error.message : 'Failed to fetch subscription';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
"
`;

