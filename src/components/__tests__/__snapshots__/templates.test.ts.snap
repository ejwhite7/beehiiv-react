exports[`api-route.ts.hbs > generates a valid Next.js API route 1`] = `
"/**
 * Next.js App Router API route for beehiiv subscription management
 * Generated by beehiiv-react — do not edit directly.
 * Located at: app/api/beehiiv/subscribe/route.ts
 */
import { NextRequest, NextResponse } from 'next/server';
import { BeehiivClient } from 'beehiiv-react/server';
import type { CreateSubscriptionRequest } from 'beehiiv-react/server';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: process.env.BEEHIIV_PUBLICATION_ID ?? 'pub_route456',
});

const MAX_SIGNUP_BODY_BYTES = 16_384;
const MAX_SIGNUPS_PER_MINUTE = 5;
const MAX_TRACKED_CLIENTS = 10_000;
const signupAttempts = new Map<string, number[]>();

function toCustomFieldValues(
  input: unknown,
): CreateSubscriptionRequest['custom_fields'] | null | undefined {
  if (input === undefined) return undefined;
  if (typeof input !== 'object' || input === null || Array.isArray(input)) {
    return null;
  }

  const fields: NonNullable<CreateSubscriptionRequest['custom_fields']> = [];
  for (const [name, value] of Object.entries(input)) {
    const validValue =
      typeof value === 'string' ||
      typeof value === 'number' ||
      typeof value === 'boolean' ||
      (Array.isArray(value) &&
        value.every((item) => typeof item === 'string'));
    if (!validValue) return null;
    fields.push({
      name,
      value: value as string | number | boolean | string[],
    });
  }
  return fields;
}

/**
 * Basic per-instance abuse control for the intentionally public signup route.
 * Replace this with a durable distributed rate limiter and/or CAPTCHA check in
 * production. Keep this hook server-side and never trust a client assertion.
 */
async function isPublicSubscriptionAllowed(
  req: NextRequest,
  _email: string,
): Promise<boolean> {
  const forwardedFor = req.headers.get('x-forwarded-for');
  const key =
    forwardedFor?.split(',')[0]?.trim() ||
    req.headers.get('x-real-ip') ||
    'unknown';
  const now = Date.now();
  const windowStart = now - 60_000;
  const recentAttempts = (signupAttempts.get(key) ?? []).filter(
    (timestamp) => timestamp > windowStart,
  );

  if (!signupAttempts.has(key) && signupAttempts.size >= MAX_TRACKED_CLIENTS) {
    for (const [trackedKey, timestamps] of signupAttempts) {
      if (!timestamps.some((timestamp) => timestamp > windowStart)) {
        signupAttempts.delete(trackedKey);
      }
    }
    if (signupAttempts.size >= MAX_TRACKED_CLIENTS) return false;
  }

  if (recentAttempts.length >= MAX_SIGNUPS_PER_MINUTE) return false;
  recentAttempts.push(now);
  signupAttempts.set(key, recentAttempts);
  return true;
}

/** POST /api/beehiiv/subscribe — Create a new subscription */
export async function POST(req: NextRequest) {
  try {
    const declaredLength = Number(req.headers.get('content-length') ?? '0');
    if (
      Number.isFinite(declaredLength) &&
      declaredLength > MAX_SIGNUP_BODY_BYTES
    ) {
      return NextResponse.json(
        { error: 'Subscription request is too large.' },
        { status: 413 },
      );
    }

    const rawBody = await req.text();
    if (rawBody.length > MAX_SIGNUP_BODY_BYTES) {
      return NextResponse.json(
        { error: 'Subscription request is too large.' },
        { status: 413 },
      );
    }

    let parsedBody: unknown;
    try {
      parsedBody = JSON.parse(rawBody);
    } catch {
      return NextResponse.json(
        { error: 'A valid JSON request body is required.' },
        { status: 400 },
      );
    }

    if (
      typeof parsedBody !== 'object' ||
      parsedBody === null ||
      Array.isArray(parsedBody)
    ) {
      return NextResponse.json(
        { error: 'A JSON object is required.' },
        { status: 400 },
      );
    }
    const body = parsedBody as Record<string, unknown>;

    const email = typeof body.email === 'string' ? body.email.trim() : '';
    if (
      email.length === 0 ||
      email.length > 254 ||
      !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)
    ) {
      return NextResponse.json(
        { error: 'A valid email address is required.' },
        { status: 400 },
      );
    }

    if (!(await isPublicSubscriptionAllowed(req, email))) {
      return NextResponse.json(
        { error: 'Too many subscription attempts.' },
        { status: 429, headers: { 'Retry-After': '60' } },
      );
    }

    const customFields = toCustomFieldValues(body.customFields);
    if (customFields === null) {
      return NextResponse.json(
        { error: 'Custom fields must contain supported scalar or string-list values.' },
        { status: 400 },
      );
    }

    const subscriptionInput: CreateSubscriptionRequest = {
      email,
      custom_fields: customFields,
      utm_source:
        typeof body.utmSource === 'string' ? body.utmSource : undefined,
      utm_medium:
        typeof body.utmMedium === 'string' ? body.utmMedium : undefined,
      utm_channel:
        typeof body.utmChannel === 'string' ? body.utmChannel : undefined,
      utm_campaign:
        typeof body.utmCampaign === 'string' ? body.utmCampaign : undefined,
      utm_term:
        typeof body.utmTerm === 'string' ? body.utmTerm : undefined,
      utm_content:
        typeof body.utmContent === 'string' ? body.utmContent : undefined,
      referring_site:
        typeof body.referringSite === 'string' ? body.referringSite : undefined,
      send_welcome_email:
        typeof body.sendWelcomeEmail === 'boolean'
          ? body.sendWelcomeEmail
          : true,
      reactivate_existing:
        typeof body.reactivateExisting === 'boolean'
          ? body.reactivateExisting
          : typeof body.reactivate === 'boolean'
            ? body.reactivate
            : false,
    };
    const subscription = await client.subscriptions.create(subscriptionInput);

    return NextResponse.json(subscription, { status: 200 });
  } catch (error: unknown) {
    const message =
      error instanceof Error ? error.message : 'Subscription failed';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
"
`;

