 * Generated: 2025-01-15T12:00:00Z
 */

export interface BeehiivCustomFields {
  /** First Name */
  firstName: string;
  /** Age */
  age?: number;
  /** Rating */
  rating?: number;
  /** Subscribed */
  subscribed?: boolean;
  /** Birth Date */
  birthDate?: string;
  /** Created At */
  createdAt?: string;
  /** Plan */
  plan?: 'Free' | 'Pro' | 'Enterprise';
}

export type BeehiivCustomFieldKey = keyof BeehiivCustomFields;
"
