exports[`server-action.ts.hbs > generates a valid server actions file 1`] = `
"/**
 * Next.js Server Actions for beehiiv subscriptions
 * Generated by beehiiv-react — do not edit directly.
 */
'use server';

import { BeehiivClient } from 'beehiiv-react/server';
import type { BeehiivCustomFields } from './beehiiv-custom-fields';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: process.env.BEEHIIV_PUBLICATION_ID ?? 'pub_sa789',
});

/**
 * Authorize a mutation of an existing subscriber.
 *
 * This deliberately throws for every call. Replace the body with a server-side
 * session and ownership check before enabling either privileged action. Never
 * trust the supplied subscription ID as proof of identity.
 */
async function assertSubscriberMutationAuthorized(
  _subscriptionId: string,
  _operation: 'update' | 'delete',
): Promise<void> {
  throw new Error('Unauthorized subscriber operation');
}

/** Payload accepted by the subscribeAction server action */
interface SubscribePayload {
  email: string;
  customFields?: BeehiivCustomFields;
  utmSource?: string;
  utmMedium?: string;
  utmChannel?: string;
  utmCampaign?: string;
  utmTerm?: string;
  utmContent?: string;
  referringSite?: string;
  reactivateExisting?: boolean;
  sendWelcomeEmail?: boolean;
}

/**
 * Subscribe an email address to the beehiiv publication.
 * Call this from a React Server Component or form action.
 *
 * @param data - The subscription data containing email, optional custom fields, and attribution
 * @returns The created subscription record (unwrapped SubscriptionInfo)
 */
export async function subscribeAction(data: SubscribePayload) {
  const response = await client.subscriptions.create({
    email: data.email,
    custom_fields: data.customFields
      ? Object.entries(data.customFields).map(([name, value]) => ({
          name,
          value: value as string | number | boolean | string[],
        }))
      : undefined,
    utm_source: data.utmSource,
    utm_medium: data.utmMedium,
    utm_channel: data.utmChannel,
    utm_campaign: data.utmCampaign,
    utm_term: data.utmTerm,
    utm_content: data.utmContent,
    referring_site: data.referringSite,
    reactivate_existing: data.reactivateExisting,
    send_welcome_email: data.sendWelcomeEmail ?? true,
  });

  return response.data;
}

/**
 * Enrich (update) a subscription's custom fields by its ID.
 * Use this to collect additional subscriber data after the initial subscribe,
 * for example in a multi-step signup form.
 *
 * @param id - The subscription ID to update (starts with "sub_")
 * @param customFields - The custom field values to set on the subscription
 * @returns The updated subscription record (unwrapped SubscriptionInfo)
 */
export async function enrichSubscriptionAction(
  id: string,
  customFields: Partial<BeehiivCustomFields>,
) {
  await assertSubscriberMutationAuthorized(id, 'update');

  const response = await client.subscriptions.updateById(id, {
    custom_fields: Object.entries(customFields).map(([name, value]) => ({
      name,
      value: value as string | number | boolean | string[],
    })),
  });

  return response.data;
}

/**
 * Unsubscribe (delete) a subscription by its ID.
 *
 * @param id - The subscription ID to delete (starts with "sub_")
 */
export async function unsubscribeAction(id: string) {
  await assertSubscriberMutationAuthorized(id, 'delete');

  await client.subscriptions.delete(id);
}
"
`;
