import { NextRequest, NextResponse } from 'next/server';
import { BeehiivClient } from 'beehiiv-react/server';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: process.env.BEEHIIV_PUBLICATION_ID ?? '{{publicationId}}',
});

/** POST /api/beehiiv/subscribe — Create a new subscription */
export async function POST(req: NextRequest) {
  try {
    const body = await req.json();

    if (!body.email || typeof body.email !== 'string') {
      return NextResponse.json(
        { error: 'A valid email address is required.' },
        { status: 400 },
      );
    }

    const subscription = await client.subscriptions.create({
      email: body.email,
      custom_fields: body.customFields,
      utm_source: body.utmSource,
      utm_medium: body.utmMedium,
      utm_campaign: body.utmCampaign,
      send_welcome_email: body.sendWelcomeEmail ?? true,
      reactivate_existing: body.reactivateExisting ?? false,
    });

    return NextResponse.json(subscription, { status: 200 });
  } catch (error: unknown) {
    const message =
      error instanceof Error ? error.message : 'Subscription failed';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}

