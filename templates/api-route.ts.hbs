/**
 * Next.js App Router API route for beehiiv subscription management
 * Generated by `beehiiv-react init`
 * Located at: app/api/beehiiv/subscribe/route.ts
 */
import { NextRequest, NextResponse } from 'next/server';
import { BeehiivClient } from 'beehiiv-react';
import { beehiivConfig } from '@/beehiiv.config';

/**
 * Initialize the beehiiv client using the server-side API key.
 * BEEHIIV_API_KEY must never be exposed to the client.
 */
const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: beehiivConfig.publicationId,
});

/** POST /api/beehiiv/subscribe — Create a new subscription */
export async function POST(req: NextRequest) {
  try {
    const body = await req.json();
    const subscription = await client.subscriptions.create({
      email: body.email,
      custom_fields: body.customFields,
      utm_source: body.utmSource,
      utm_medium: body.utmMedium,
      utm_campaign: body.utmCampaign,
      send_welcome_email: body.sendWelcomeEmail ?? true,
      reactivate_existing: body.reactivateExisting ?? false,
    });
    return NextResponse.json({ data: subscription }, { status: 200 });
  } catch (error: unknown) {
    const msg = error instanceof Error ? error.message : 'Subscription failed';
    return NextResponse.json({ error: msg }, { status: 500 });
  }
}
