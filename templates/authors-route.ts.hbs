/**
 * Next.js App Router API route for beehiiv authors (list + detail)
 * Generated by beehiiv-react — do not edit directly.
 * Located at: app/api/beehiiv/authors/route.ts
 */
import { NextRequest, NextResponse } from 'next/server';
import { BeehiivClient } from 'beehiiv-react/server';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: process.env.BEEHIIV_PUBLICATION_ID ?? '{{publicationId}}',
});

/** GET /api/beehiiv/authors — List authors with page-based pagination */
export async function GET(req: NextRequest) {
  try {
    const searchParams = req.nextUrl.searchParams;
    const authorId = searchParams.get('authorId');

    // Single author lookup
    if (authorId) {
      const response = await client.authors.get(authorId);
      return NextResponse.json({ data: response.data }, { status: 200 });
    }

    // List authors with pagination
    const page = searchParams.get('page');
    const limit = searchParams.get('limit');

    const response = await client.authors.list({
      page: page ? Number(page) : undefined,
      limit: limit ? Number(limit) : undefined,
    });

    return NextResponse.json(
      {
        data: response.data,
        pagination: {
          page: response.page,
          limit: response.limit,
          total_results: response.total_results,
          total_pages: response.total_pages,
        },
      },
      { status: 200 },
    );
  } catch (error: unknown) {
    const message =
      error instanceof Error ? error.message : 'Failed to fetch authors';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
