/**
 * Blog index page \u2014 lists all confirmed posts.
 * Generated by `beehiiv-react init` (blog feature).
 * Located at: app/{{routePrefix}}/page.tsx
 *
 * Edit freely; re-running `beehiiv-react init` will prompt before overwriting.
 */
import Link from 'next/link';
import { BeehiivClient, fetchPosts } from 'beehiiv-react/server';
import { PostCard } from 'beehiiv-react';

export const revalidate = 300;

const PUBLICATION_ID =
  process.env.BEEHIIV_PUBLICATION_ID ?? '{{publicationId}}';

export const metadata = {
  title: '{{{blogTitleTs}}}',
  description: '{{{blogDescriptionTs}}}',
};

export default async function BlogIndexPage() {
  const client = new BeehiivClient({
    apiKey: process.env.BEEHIIV_API_KEY!,
    publicationId: PUBLICATION_ID,
  });

  const posts = await fetchPosts(client, PUBLICATION_ID, {
    status: 'confirmed',
    audience: 'both',
    orderBy: 'publish_date',
    direction: 'desc',
    limit: 50,
  });

  return (
    <main className="beehiiv-blog-index">
      <header>
        <h1>{{blogTitle}}</h1>
        <p>{{blogDescription}}</p>
      </header>

      <ul className="beehiiv-blog-list" style={{ listStyle: 'none', padding: 0 }}>
        {posts.map((post) => (
          <li key={post.id}>
            <Link href={`/{{routePrefix}}/${post.slug}`} style={{ textDecoration: 'none', color: 'inherit' }}>
              <PostCard post={post} />
            </Link>
          </li>
        ))}
      </ul>

      {posts.length === 0 && <p>No posts published yet.</p>}
    </main>
  );
}
