/**
 * Blog post detail page.
 * Generated by `beehiiv-react init` (blog feature).
 * Located at: app/{{routePrefix}}/[slug]/page.tsx
 *
 * Renders a single beehiiv post resolved by slug. Premium posts are gated
 * server-side — free/public visitors see the paywall fallback while the
 * full body renders only for active premium subscribers. Wire up your own
 * auth/session logic in `getViewerSubscription()`.
 */
import { cache } from 'react';
import { notFound } from 'next/navigation';
import {
  BeehiivClient,
  fetchPostBySlug,
  fetchAllPostSlugs,
  generatePostMetadata,
} from 'beehiiv-react/server';
import { PostContentRenderer } from 'beehiiv-react';

export const revalidate = 300;

const PUBLICATION_ID =
  process.env.BEEHIIV_PUBLICATION_ID ?? '{{publicationId}}';
const SITE_URL = process.env.NEXT_PUBLIC_SITE_URL ?? '';

function getClient() {
  return new BeehiivClient({
    apiKey: process.env.BEEHIIV_API_KEY!,
    publicationId: PUBLICATION_ID,
  });
}

/**
 * Resolve a post by slug, memoised per-request with React `cache()`.
 *
 * `generateMetadata` and the page component both need the post; wrapping the
 * fetch in `cache()` means the underlying posts-list scan + content fetch run
 * once per render instead of twice.
 */
const getPost = cache((slug: string) =>
  fetchPostBySlug(getClient(), PUBLICATION_ID, slug),
);

export async function generateStaticParams() {
  return fetchAllPostSlugs(getClient(), PUBLICATION_ID);
}

export async function generateMetadata({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;
  const post = await getPost(slug);
  if (!post) return {};
  return generatePostMetadata(post, {
    canonicalUrl: SITE_URL ? `${SITE_URL}/{{routePrefix}}/${slug}` : undefined,
  });
}

/**
 * Stub for resolving the current viewer's subscription tier.
 * Replace with your own auth integration (NextAuth, Clerk, custom JWT, etc.).
 */
async function getViewerSubscription(): Promise<{
  status?: 'active' | 'inactive';
  tier?: 'free' | 'premium';
} | null> {
  return null;
}

export default async function BlogPostPage({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;
  const post = await getPost(slug);
  if (!post) notFound();

  // Only `premium` posts are gated. `free` and `both` posts are public web
  // content and render for everyone. Replace `getViewerSubscription()` with
  // your own auth/session lookup to unlock premium posts for paid members.
  const subscription = await getViewerSubscription();
  const canView =
    post.audience !== 'premium' ||
    (subscription?.tier === 'premium' && subscription?.status === 'active');

  return (
    <article className="beehiiv-blog-post">
      <header>
        <h1>{post.title}</h1>
        {post.subtitle && <p className="subtitle">{post.subtitle}</p>}
        {post.publish_date != null && (
          <time dateTime={new Date(post.publish_date * 1000).toISOString()}>
            {new Date(post.publish_date * 1000).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        )}
      </header>

      {canView ? (
        <PostContentRenderer content={post.content ?? null} />
      ) : (
        <div className="beehiiv-paywall">
          <h2>This post is for paid subscribers</h2>
          <p>Subscribe to unlock full access.</p>
        </div>
      )}
    </article>
  );
}
