/**
 * RSS 2.0 feed for the blog.
 * Generated by `beehiiv-react init` (blog feature).
 * Located at: app/{{routePrefix}}/rss.xml/route.ts
 */
import { BeehiivClient, fetchPosts } from 'beehiiv-react/server';

export const revalidate = 600;

const PUBLICATION_ID =
  process.env.BEEHIIV_PUBLICATION_ID ?? '{{publicationId}}';
const SITE_URL = process.env.NEXT_PUBLIC_SITE_URL ?? '';

function escapeXml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;');
}

export async function GET(): Promise<Response> {
  const client = new BeehiivClient({
    apiKey: process.env.BEEHIIV_API_KEY!,
    publicationId: PUBLICATION_ID,
  });

  const posts = await fetchPosts(client, PUBLICATION_ID, {
    status: 'confirmed',
    audience: 'both',
    orderBy: 'publish_date',
    direction: 'desc',
    limit: 50,
  });

  const items = posts
    .map((post) => {
      const link = `${SITE_URL}/{{routePrefix}}/${post.slug ?? post.id}`;
      const pubDate =
        post.publish_date != null
          ? new Date(post.publish_date * 1000).toUTCString()
          : new Date().toUTCString();
      return `
    <item>
      <title>${escapeXml(post.title ?? '')}</title>
      <link>${escapeXml(link)}</link>
      <guid isPermaLink="true">${escapeXml(link)}</guid>
      <pubDate>${pubDate}</pubDate>
      ${post.subtitle ? `<description>${escapeXml(post.subtitle)}</description>` : ''}
    </item>`;
    })
    .join('');

  const xml = `<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{blogTitle}}</title>
    <link>${escapeXml(SITE_URL)}/{{routePrefix}}</link>
    <description>{{blogDescription}}</description>
    ${items}
  </channel>
</rss>`;

  return new Response(xml, {
    headers: {
      'Content-Type': 'application/xml; charset=utf-8',
      'Cache-Control': 's-maxage=600, stale-while-revalidate',
    },
  });
}
