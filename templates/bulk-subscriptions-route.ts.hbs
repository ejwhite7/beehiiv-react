/** POST /api/beehiiv/bulk-subscriptions — Create multiple subscriptions in bulk */
export async function POST(req: NextRequest) {
  try {
    if (!(await isBulkSubscriptionCreationAuthorized(req))) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const body = await req.json();

    if (
