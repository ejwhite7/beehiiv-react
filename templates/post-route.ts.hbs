import { NextRequest, NextResponse } from 'next/server';
import { BeehiivClient, canViewContent } from 'beehiiv-react/server';
import type { PostInfo } from 'beehiiv-react/server';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: process.env.BEEHIIV_PUBLICATION_ID ?? '{{publicationId}}',
});

/** Replace with a server-side session and post-access check. */
async function isRestrictedPostLookupAuthorized(
  _req: NextRequest,
  _post: PostInfo,
): Promise<boolean> {
  return false;
}

/** GET /api/beehiiv/posts/[id] — Return one authorized post. */
export async function GET(
  req: NextRequest,
  { params }: { params: Promise<{ id: string }> },
) {
  try {
    if (
      req.nextUrl.searchParams.has('publicationId') ||
      req.nextUrl.searchParams.has('publication_id')
    ) {
      return NextResponse.json(
        { error: 'Publication override is not supported.' },
        { status: 400 },
      );
    }

    const { id } = await params;
    const response = await client.posts.get(id, {
      expand: ['free_web_content', 'tags'],
    });
    const post = response.data;
    const isPublic =
      post.status === 'confirmed' &&
      canViewContent(
        null,
        null,
        post.audience,
        post.enforce_gated_content ?? true,
      );

    if (!isPublic && !(await isRestrictedPostLookupAuthorized(req, post))) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    return NextResponse.json({ data: post }, { status: 200 });
  } catch (error: unknown) {
    const message = error instanceof Error ? error.message : 'Failed to fetch post';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
