import { NextRequest, NextResponse } from 'next/server';
import { BeehiivClient } from 'beehiiv-react';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: process.env.BEEHIIV_PUBLICATION_ID ?? '{{publicationId}}',
});

/** GET /api/beehiiv/posts — List posts with page-based pagination */
export async function GET(req: NextRequest) {
  try {
    const searchParams = req.nextUrl.searchParams;
    const page = searchParams.get('page');
    const limit = searchParams.get('limit');
    const status = searchParams.get('status') as
      | 'draft'
      | 'confirmed'
      | 'archived'
      | undefined;
    const audience = searchParams.get('audience') as
      | 'free'
      | 'premium'
      | 'all'
      | undefined;

    const response = await client.posts.list({
      page: page ? Number(page) : undefined,
      limit: limit ? Number(limit) : undefined,
      status: status ?? undefined,
      audience: audience ?? undefined,
    });

    return NextResponse.json(
      { data: response.data, pagination: response.pagination },
      { status: 200 },
    );
  } catch (error: unknown) {
    const message =
      error instanceof Error ? error.message : 'Failed to fetch posts';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
