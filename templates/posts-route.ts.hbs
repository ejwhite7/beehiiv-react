/**
 * Next.js App Router API route for beehiiv posts (list + detail)
 * Generated by beehiiv-react — do not edit directly.
 * Located at: app/api/beehiiv/posts/route.ts
 */
import { NextRequest, NextResponse } from 'next/server';
import { unstable_cache } from 'next/cache';
import { BeehiivClient, fetchPostBySlug } from 'beehiiv-react/server';

const DEFAULT_PUBLICATION_ID =
  process.env.BEEHIIV_PUBLICATION_ID ?? '{{publicationId}}';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: DEFAULT_PUBLICATION_ID,
});

/**
 * Slug lookup is an O(N/limit) scan of the posts list, so cache the result
 * (including misses) per (publicationId, slug). This dedupes repeated
 * requests and prevents unmatched slugs from re-scanning the list on every
 * call — slugs are stable, so a short TTL is safe.
 */
const getPostBySlug = unstable_cache(
  (publicationId: string, slug: string) =>
    fetchPostBySlug(client, publicationId, slug),
  ['beehiiv-post-by-slug'],
  { revalidate: 300 },
);

/**
 * GET /api/beehiiv/posts
 *
 *  - Without `slug`: list posts with page-based pagination.
 *  - With `?slug=my-post`: resolve a single post by slug. Returns
 *    `{ data: PostInfo | null }` so the client can distinguish 200-with-null
 *    from a server error.
 */
export async function GET(req: NextRequest) {
  try {
    const searchParams = req.nextUrl.searchParams;

    // --- Slug lookup branch ---
    const slug = searchParams.get('slug');
    if (slug) {
      const publicationId =
        searchParams.get('publicationId') ?? DEFAULT_PUBLICATION_ID;
      const post = await getPostBySlug(publicationId, slug);
      return NextResponse.json({ data: post }, { status: 200 });
    }

    const page = searchParams.get('page');
    const limit = searchParams.get('limit');
    const status = searchParams.get('status') as
      | 'draft'
      | 'confirmed'
      | 'archived'
      | undefined;
    const audience = searchParams.get('audience') as
      | 'free'
      | 'premium'
      | 'all'
      | undefined;

    const expand = searchParams.getAll('expand[]');
    const orderBy = searchParams.get('order_by') ?? 'publish_date';
    const direction = searchParams.get('direction') ?? 'desc';

    const response = await client.posts.list({
      page: page ? Number(page) : undefined,
      limit: limit ? Number(limit) : undefined,
      status: status ?? undefined,
      audience: audience ?? undefined,
      expand: expand.length > 0 ? expand : undefined,
      orderBy,
      direction: direction as 'asc' | 'desc',
    });

    return NextResponse.json(
      {
        data: response.data,
        pagination: {
          page: response.page,
          limit: response.limit,
          total_results: response.total_results,
          total_pages: response.total_pages,
        },
      },
      { status: 200 },
    );
  } catch (error: unknown) {
    const message =
      error instanceof Error ? error.message : 'Failed to fetch posts';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
