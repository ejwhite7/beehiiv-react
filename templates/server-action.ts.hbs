/**
 * Next.js Server Action for beehiiv subscriptions
 * Generated by `beehiiv-react init`
 */
'use server';

import { BeehiivClient } from 'beehiiv-react';
import { beehiivConfig } from '@/beehiiv.config';
import type { BeehiivCustomFields } from '@/types/beehiiv.generated';

const client = new BeehiivClient({
  apiKey: process.env.BEEHIIV_API_KEY!,
  publicationId: beehiivConfig.publicationId,
});

/**
 * Subscribe an email address to the beehiiv publication.
 * Call this from a React Server Component or form action.
 */
export async function subscribeAction(
  email: string,
  customFields?: BeehiivCustomFields,
) {
  const subscription = await client.subscriptions.create({
    email,
    custom_fields: customFields
      ? Object.entries(customFields).map(([name, value]) => ({ name, value }))
      : undefined,
    send_welcome_email: true,
  });
  return subscription;
}
