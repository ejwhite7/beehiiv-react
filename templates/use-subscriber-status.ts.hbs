    if (typeof document !== 'undefined') {
      setCookie(COOKIE_NAME, 'true', COOKIE_MAX_AGE);
    }
    if (typeof window !== 'undefined') {
      try {
        localStorage.setItem(LS_KEY, 'true');
      } catch {
        // localStorage may be unavailable
